rules_version = '2';

// 全境封鎖2 配裝工具 / Division 2 build planner — player data.
//
// One document per player, users/{uid}, holding their language, collectible
// progress and saved builds. A player can read and write only their own, and
// nobody can list other players.
//
// map/overrides holds the map's position corrections from the position
// editor (/map-edit/): anyone may read it, only the site owner may write it.
// The editor shows the signed-in account's uid to put in OWNER_UID.
//
// Paste this into
// Firebase console → Firestore Database → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['v', 'lang', 'collectibles', 'builds', 'updatedAt'])
        && request.resource.data.builds is list
        && request.resource.data.builds.size() <= 50
        && request.resource.data.collectibles is map;
    }
    match /map/{doc} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == 'OWNER_UID'
        && request.resource.data.keys().hasOnly(['pins', 'rings', 'updatedAt']);
    }
  }
}
